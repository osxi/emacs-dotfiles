# Emacs runtime state — machine-specific, not config
var/ ; centralized backup/autosave files
auto-save-list/
*~
*.bak
.#*

# Package management
elpa/
eln-cache/
*.elc

# site-lisp (local packages, e.g., git clones or manual downloads)
# But track the .el files themselves if committed, just not .git/ dirs
site-lisp/.*

# Customizations written by M-x customize
custom.el

# Transient data
transient/
.cache/

# Projectile
projectile-bookmarks.eld
projectile.cache
projects.eld

# Minibuffer history
history

# OS-specific
.DS_Store
